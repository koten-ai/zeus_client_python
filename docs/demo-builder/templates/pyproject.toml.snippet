# Demo Builder Kit — pyproject.toml snippet
# Replace: PACKAGE_NAME, PACKAGE_DIR, description

[build-system]
requires = ["setuptools>=69"]
build-backend = "setuptools.build_meta"

[project]
name = "PACKAGE_NAME"
version = "0.1.0"
description = "Zeus demo app (Demo Builder Kit scaffold)"
requires-python = ">=3.11"
dependencies = [
    "flask==3.1.0",
    "fastapi==0.115.6",
    "uvicorn[standard]==0.34.0",
    "httpx==0.28.1",
    # Monorepo path (preferred in this workspace):
    "kotenai-zeus-client @ file:../zeus_client_python",
    # Or published wheel when available:
    # "kotenai-zeus-client>=0.1.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
]

[project.scripts]
PACKAGE_NAME = "PACKAGE_DIR.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
PACKAGE_DIR = ["templates/*", "static/*", "static/**/*"]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
pythonpath = ["src"]
markers = [
    "integration: tests that require live Zeus or LLM services",
]
