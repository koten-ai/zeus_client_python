# Demo Builder Kit — Dockerfile snippet
# Build from monorepo parent (koten-ai/) so zeus_client_python is available:
#   docker build -f demo_<domain>/Dockerfile .
#
# Replace: demo_<domain>, PACKAGE module name in CMD

FROM python:3.12-slim

WORKDIR /app

COPY demo_<domain>/pyproject.toml demo_<domain>/requirements.txt ./
COPY zeus_client_python /tmp/zeus_client_python
COPY demo_<domain>/src ./src
COPY demo_<domain>/data ./data
COPY demo_<domain>/config.example.json .

RUN pip install --no-cache-dir /tmp/zeus_client_python \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps -e .

ENV PORT=5000
ENV ZEUS_CLIENT_CONFIG_DIR=/app
ENV ZEUS_CHAT_REQUESTS_DIR=/app/data/chat_requests

EXPOSE 5000
CMD ["python", "-m", "PACKAGE_DIR"]
