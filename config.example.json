{
  "profile": "development",
  "zeus": {
    "url": "http://127.0.0.1:8080",
    "auth_mode": "none",
    "username": null,
    "password_env": null,
    "token_env": null,
    "timeout_s": 30
  },
  "target": {
    "bucket": "yelp-data",
    "scope": "_default",
    "collection": "_default"
  },
  "llm": {
    "provider": "xai",
    "base_url": "https://api.x.ai/v1",
    "model": "grok-4-1-non-reasoning",
    "api_key_env": "XAI_API_KEY",
    "context_window_tokens": 128000,
    "context_soft_limit": 0.8,
    "timeout_s": 120,
    "roles": {
      "orchestrator": { "model": "strong-planner", "api_key_env": "LLM_ORCH_KEY" },
      "advisor": { "model": "strong-planner", "api_key_env": "LLM_ADV_KEY" },
      "worker": { "model": "fast-worker", "api_key_env": "LLM_WORKER_KEY" }
    }
  },
  "jobs": {
    "host_url": null,
    "watch_transport": "sse"
  },
  "settings": {
    "ai_process_result": false,
    "max_rounds": 8,
    "force_trace": false,
    "mode": "analytics",
    "durable_sessions": true
  },
  "session": {
    "semantic_cache": {
      "enabled": false,
      "apply_to_modes": ["agent"],
      "recall": {
        "enabled": true,
        "top_k": 5,
        "min_score": 0.0,
        "min_query_chars": 12,
        "timeout_ms": 150,
        "fail_closed": false,
        "types": ["profile", "semantic", "conversational"]
      },
      "inject": {
        "bag": "B",
        "key": "semantic_memory",
        "max_chars": 4000,
        "max_blocks": 5,
        "include_fields": ["summary", "text"],
        "order": "score_desc"
      },
      "write": {
        "enabled": true,
        "on_turn_commit": true,
        "write_explicit_only": true,
        "write_user_message": false,
        "write_assistant_summary": false,
        "default_type": "conversational",
        "min_chars": 24,
        "max_chars_per_block": 2000,
        "max_blocks_per_turn": 3,
        "ttl_seconds": 604800,
        "async": true
      }
    }
  },
  "retry": {
    "max_attempts": 3,
    "base_delay_ms": 200,
    "max_delay_ms": 5000,
    "jitter": true
  },
  "redaction": {
    "enabled": true,
    "preview_max_chars": 2048
  },
  "logging": {
    "level": "info",
    "redact": true,
    "otel_enabled": false,
    "otel_endpoint": null,
    "service_name": "zeus_client"
  },
  "client": {
    "ip_address": null
  },
  "debug": {
    "detective_briefing": true,
    "capture_bodies": false,
    "transport_replay": true,
    "rewind": false
  },
  "chat_requests_dir": null
}
